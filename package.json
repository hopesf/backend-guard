    "express",
    "security",
    "middleware",
    "helmet",
    "cors",
    "rate-limit",
    "xss",
    "validation",
    "zod",
    "joi",
    "ip-blacklist",
    "request-logging",
    "backend-security"
  ],
  "homepage": "https://github.com/hopesf/backend-guard#readme",
  "bugs": {
    "url": "https://github.com/hopesf/backend-guard/issues"
