{
  "name": "backend-guard",
  "version": "2.1.0",
  "description": "Secure-by-default security layer for Express, Fastify and NestJS — headers, CORS, rate limit, XSS sanitization, safe request logging, IP blacklist, plus a startup doctor that flags risky configuration.",
  "keywords": [
    "backend-security",
    "cors",
    "doctor",
    "express",
    "hardening",
    "helmet",
    "ip-blacklist",
    "middleware",
    "nestjs",
    "nestjs-module",
    "nestjs-security",
    "nosql-injection",
    "parameter-pollution",
    "rate-limit",
    "request-logging",
    "security",
    "security-audit",
    "xss"
  ],
  "homepage": "https://github.com/hopesf/backend-guard#readme",
  "bugs": {
    "url": "https://github.com/hopesf/backend-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hopesf/backend-guard.git"
  },
  "license": "MIT",
  "author": "Selim Gecin",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:pack": "npm run build && node scripts/pack-check.js",
    "prepublishOnly": "npm run build && npm test && node scripts/pack-check.js"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "@fastify/cors": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "@fastify/helmet": "^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0",
    "@fastify/rate-limit": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "fastify-plugin": "^4.0.0 || ^5.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "fastify-plugin": {
      "optional": true
    },
    "@fastify/helmet": {
      "optional": true
    },
    "@fastify/cors": {
      "optional": true
    },
    "@fastify/rate-limit": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/testing": "^11.2.11",
    "@nestjs/throttler": "^6.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "express": "^5.3.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "default": "./dist/express/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "default": "./dist/fastify/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "express": [
        "dist/express/index.d.ts"
      ],
      "fastify": [
        "dist/fastify/index.d.ts"
      ],
      "nestjs": [
        "dist/nestjs/index.d.ts"
      ],
      "core": [
        "dist/core/index.d.ts"
      ]
    }
  },
  "bin": {
    "backend-guard": "dist/cli/index.js"
  }
}
